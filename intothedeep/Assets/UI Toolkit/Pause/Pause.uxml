            <ui:Label tabindex="-1" text="Press R or Select for Main Menu" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Paused" class="text" style="top: 971px; left: 26px; width: 561px; -unity-font-style: normal; font-size: 45px;" />
            <ui:Button text="Main Menu" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MainMenu" enable-rich-text="true" class="text" style="height: 189px; width: 387px; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UIImages/Setting%20Button.png?fileID=2800000&amp;guid=e66ca4ab0e5f27446b1be8ce7a3654bf&amp;type=3#Setting Button&quot;); top: 570px; left: 95px;" />
