<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Pause/Pause.uss?fileID=7433441132597879392&amp;guid=49e4c5d7e88856340a716f5edbe5ba73&amp;type=3#Pause" />
    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; transition-timing-function: ease-in; transition-duration: 0.5s;">
        <ui:VisualElement name="Background" picking-mode="Ignore" class="inactive" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UIImages/Pause.png?fileID=2800000&amp;guid=05dab2ee096ed9d419659aa70e7f8043&amp;type=3#Pause&quot;); transition-duration: 0.5s; transition-timing-function: ease-in; -unity-background-image-tint-color: rgb(47, 143, 181);">
            <ui:VisualElement name="BG" style="flex-grow: 1; position: absolute; height: 1086px; width: 1928px; background-image: url(&quot;project://database/Assets/Packages/Splines/2.8.0/Spline%20Examples%20(requires%20Shader%20Graph%20package)/Models/Car/Textures/CarBumper.png?fileID=2800000&amp;guid=11cf306d5a3444f37baacf805ec4bc20&amp;type=3#CarBumper&quot;); -unity-background-image-tint-color: rgba(148, 248, 255, 0.16);" />
            <ui:VisualElement name="Logo" style="flex-grow: 1; position: absolute; height: 224px; width: 584px; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UIImages/final_logo_1.png?fileID=2800000&amp;guid=cc837abb4dcf3cb4f888d597465a3eaa&amp;type=3#final_logo_1&quot;); top: 224px; left: 8px;" />
