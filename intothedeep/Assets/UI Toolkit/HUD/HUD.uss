.label {
    width: 240px;
    height: 78px;
    background-image: none;
    -unity-font-style: bold;
    font-size: 40px;
    top: 40px;
    left: 54px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UIImages/LowerResolution%20SDF.asset?fileID=11400000&guid=fbe5783332767214398bbc7a09830787&type=2#LowerResolution SDF");
    -unity-text-align: upper-left;
    letter-spacing: 9px;
}

.scores {
    position: absolute;
    left: 1780px;
    font-size: 37px;
    transition-duration: 0.5s;
    transition-timing-function: ease-in;
    -unity-text-align: upper-right;
    transition-property: all;
}

.one {
    font-size: 50px;
    top: 130px;
    -unity-text-outline-color: rgb(30, 175, 215);
    -unity-text-outline-width: 5px;
    left: 1460px;
}

.two {
    top: 200px;
    font-size: 40px;
    left: 1460px;
}

.three {
    font-size: 30px;
    top: 270px;
    left: 1460px;
}

.four {
    top: 340px;
    font-size: 25px;
    left: 1460px;
}

.tricks {
    position: absolute;
    font-size: 37px;
    -unity-text-align: upper-left;
    top: 972px;
    left: 42px;
    transition-duration: 0.3s;
    transition-timing-function: ease-in;
    color: rgb(126, 245, 255);
}

.tricker {
    left: 645px;
    top: 692px;
    font-size: 50px;
    rotate: -21deg;
}

.tzero {
    left: 42px;
    top: 970px;
    opacity: 1;
}

.tone {
    top: 920px;
    left: 42px;
}

.ttwo {
    top: 870px;
    opacity: 0.75;
}

.tthree {
    top: 820px;
    opacity: 0.5;
}

.tfour {
    top: 770px;
    opacity: 0.25;
}

#Combo .unity-progress-bar__progress {
    background-color: red;
}
